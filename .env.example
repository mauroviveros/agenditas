# Copiá este archivo a .env.local (no se versiona) y completá lo que falta.
# Lo leen Next (`pnpm dev`, `pnpm build`) y el CLI de Supabase (`supabase start`).

# Supabase local: salen de `pnpm exec supabase status`. Son públicas.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Cliente OAuth "Agenditas local" de Google Cloud. Secreto: nunca a git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Solo para `pnpm holidays:sync` (carga los feriados). Es la clave de servicio: se salta
# la RLS, es secreta y nunca va a git. En local sale de `pnpm exec supabase status`.
SUPABASE_SERVICE_ROLE_KEY=
