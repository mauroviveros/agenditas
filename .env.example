# Copiá este archivo a .env.local. En local, los valores salen de `pnpm supabase status`.

# URL de la API de Supabase (cliente y servidor)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Clave publicable, no la `anon` heredada (cliente y servidor)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta: solo servidor, para webhooks y cron. Nunca con NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Google para `supabase start`. Van en supabase/.env (no en .env.local) y se prenden en supabase/config.toml
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
